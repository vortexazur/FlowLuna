{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.flowluna.player",
  "productName": "FlowLuna",
  "copyright": "Copyright © 2026 FlowLuna",
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "bin",
      "to": "bin",
      "filter": ["**/*"]
    }
  ],
  "asar": true,
  "asarUnpack": [
    "**/bin/**"
  ],
  "fileAssociations": [
    {
      "ext": ["mp3", "flac", "wav", "ogg", "oga", "m4a", "aac", "opus", "wma", "alac", "aiff", "aif", "m4b"],
      "name": "FlowLuna Audio File",
      "description": "Fichier audio FlowLuna",
      "role": "Viewer"
    },
    {
      "ext": ["mp4", "mkv", "webm", "mov", "avi", "m4v", "wmv", "flv", "3gp", "ts", "m2ts", "ogv"],
      "name": "FlowLuna Video File",
      "description": "Fichier vidéo FlowLuna",
      "role": "Viewer"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.ico",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "FlowLuna",
    "runAfterFinish": true
  }
}
